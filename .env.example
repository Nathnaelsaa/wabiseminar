# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# The app URL will be handled via req.headers.origin or a fixed var if deployed
APP_URL=http://localhost:3000

# Optional: Remote MySQL/MariaDB database (e.g. hosted in cPanel)
# If these options are empty, Wabiseminar will automatically fall back to its internal local SQLite database.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DB_SSL=false
